# Anthropic API key for the Claude Haiku audit pipeline.
# Get one at https://console.anthropic.com — Settings -> API Keys -> Create Key.
# This is the ONLY variable that is strictly required to run the app.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model to call. Defaults to Haiku 4.5 (cheapest model with
# strong reasoning). Override only if you want to test Sonnet/Opus.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional: multi-model ensemble ----------------------------------------
# If you add an OpenAI and/or Google Gemini key, the audit runs a REAL
# multi-model ensemble: each model independently extracts claims and the app
# measures genuine cross-model agreement. With only the Anthropic key, the app
# falls back to two temperature-varied Claude passes (self-consistency).
# Get keys at https://platform.openai.com/api-keys and
# https://aistudio.google.com/app/apikey
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional. NCBI / PubMed API key. Without it you get ~3 requests/sec;
# with it you get ~10 requests/sec, which matters when an audit cites
# many papers. Get one at https://www.ncbi.nlm.nih.gov/account ->
# Settings -> API Key Management.
NCBI_API_KEY=

# Optional. Resend.com API key, used to email you new lead-capture form
# submissions. If blank, leads are written to the server console only.
# Get one at https://resend.com -> API Keys.
RESEND_API_KEY=

# Where new leads get emailed when RESEND_API_KEY is set. Usually your
# own inbox. Ignored if RESEND_API_KEY is blank.
LEAD_NOTIFICATION_EMAIL=founder@secondread.health

# Hard daily cap on audits per visitor IP. Protects the free tier from
# abuse and runaway Anthropic spend.
DAILY_AUDIT_LIMIT_PER_IP=5

# --- Optional: durable rate limiting + shareable audit links ---------------
# If you create a Vercel KV (Upstash Redis) store and set these two variables,
# rate limiting becomes durable across all serverless instances (not just
# per-instance), AND completed audits are saved so each one gets a shareable
# /a/<id> link. Without them, rate limiting is best-effort in-memory and
# sharing is disabled. In Vercel: Storage -> Create -> KV; the dashboard gives
# you these exact variable names.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# How long shared audits are kept (seconds). Default 30 days.
AUDIT_SHARE_TTL_SECONDS=2592000

# Public site URL used for canonical links, OG tags, and email links.
# Set to your Vercel preview URL during testing, then your custom
# domain after launch. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://secondread.health
